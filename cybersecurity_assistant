<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cairn // Advanced Cyber Intelligence Desk</title>
    <!-- Tailwind CSS for modern utility styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons for high-fidelity interactive symbols -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cyber: {
                            slate: '#16080B',    // Extremely dark burgundy/black canvas
                            card: '#220D12',     // Rich dark cherry card background
                            subcard: '#2D1117',  // Medium-dark velvet subcard
                            border: '#4A1D27',   // Velvet burgundy border
                            active: '#BE123C',   // Deep rose crimson active highlight
                            accent: '#F43F5E',   // Bright vibrant rose/burgundy accent
                            alert: '#FDA4AF',    // Coral pink alert text
                            amber: '#FB7185',    // Soft warm rose
                            text: '#FFE4E6',     // Creamy pink-white high-contrast text
                            muted: '#A2848B'     // Desaturated burgundy gray for auxiliary text
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .workspace-transition {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        /* Custom velvet-burgundy scrollbar styling */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #16080B;
        }
        ::-webkit-scrollbar-thumb {
            background: #4A1D27;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #BE123C;
        }
        
        /* Force scrollability on analysis output panel */
        #analysis-output-container {
            overflow-y: auto !important;
            scrollbar-width: thin;
            scrollbar-color: #BE123C #16080B;
        }
    </style>
</head>
<body class="bg-stone-50 text-stone-900 dark:bg-cyber-slate dark:text-cyber-text min-h-screen flex flex-col transition-colors duration-200 overflow-hidden font-sans">

    <!-- MAIN APPLICATION HEADER -->
    <header class="border-b border-stone-200 dark:border-cyber-border bg-white dark:bg-cyber-card px-5 py-3 flex items-center justify-between shadow-md z-20">
        <div class="flex items-center space-x-3.5">
            <!-- Sidebar collapsible toggle -->
            <button id="btn-toggle-sidebar" class="p-2 rounded bg-stone-100 dark:bg-cyber-subcard hover:bg-stone-200 dark:hover:bg-cyber-border text-stone-600 dark:text-cyber-muted transition-all flex items-center justify-center" title="Toggle Sidebar Control Deck">
                <i data-lucide="menu" class="w-4 h-4"></i>
            </button>
            <div class="flex items-center space-x-2.5">
                <div class="p-1.5 bg-rose-500/10 rounded-lg text-cyber-accent">
                    <i data-lucide="terminal" class="w-5 h-5"></i>
                </div>
                <div>
                    <h1 class="text-base font-extrabold tracking-tight dark:text-cyber-text">CAIRN <span class="text-xs font-mono font-normal text-rose-900 dark:text-cyber-muted">// Velvet Intelligence Desk</span></h1>
                </div>
            </div>
        </div>

        <!-- HEADER CONTROLS (Pills, Mode Toggles) -->
        <div class="flex items-center space-x-3.5">
            <!-- Token validation status pill -->
            <div id="api-status-pill" class="flex items-center space-x-1.5 px-3 py-1 rounded-full text-[10px] font-mono bg-stone-100 text-stone-600 dark:bg-cyber-subcard dark:text-cyber-muted border border-stone-200 dark:border-cyber-border transition-colors">
                <span class="w-2.5 h-2.5 rounded-full bg-stone-400 dark:bg-stone-600" id="status-indicator-dot"></span>
                <span id="status-indicator-text" class="uppercase font-semibold">Offline</span>
            </div>

            <!-- Dark Mode Toggle -->
            <button id="dark-mode-toggle" class="p-2 rounded bg-stone-100 dark:bg-cyber-subcard hover:bg-stone-200 dark:hover:bg-cyber-border text-stone-600 dark:text-cyber-muted transition-all" title="Toggle Contrast Modes">
                <i data-lucide="moon" class="w-4 h-4 hidden dark:block"></i>
                <i data-lucide="sun" class="w-4 h-4 block dark:hidden"></i>
            </button>
        </div>
    </header>

    <!-- PRIMARY RUNTIME FRAME CONTAINER (Strict height constraints) -->
    <div class="flex-1 flex overflow-hidden h-[calc(100vh-57px)] relative w-full">
        
        <!-- SIDEBAR DECK: Library & Configuration Controls -->
        <aside id="workspace-sidebar" class="workspace-transition w-[320px] flex-shrink-0 border-r border-stone-200 dark:border-cyber-border bg-stone-50 dark:bg-cyber-card flex flex-col h-full overflow-hidden z-10">
            
            <!-- SECTION 1: Paper Library File Dropper -->
            <div class="p-4 border-b border-stone-200 dark:border-cyber-border flex flex-col space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold font-mono tracking-wider uppercase text-stone-400 dark:text-cyber-muted flex items-center gap-1.5">
                        <i data-lucide="archive" class="w-3.5 h-3.5"></i> Cyber Repository
                    </span>
                    <span id="library-count" class="text-[10px] font-mono px-2 py-0.5 rounded bg-stone-200 dark:bg-cyber-subcard text-stone-500 dark:text-cyber-muted">2 Ready</span>
                </div>

                <!-- Interactive drag/drop box -->
                <div id="drop-zone" class="border border-dashed border-stone-300 dark:border-cyber-border hover:border-cyber-accent dark:hover:border-cyber-accent rounded-lg p-4 text-center cursor-pointer bg-white dark:bg-cyber-subcard/40 hover:bg-stone-50 dark:hover:bg-cyber-subcard/80 transition-all">
                    <input type="file" id="file-picker" accept=".pdf" class="hidden" multiple />
                    <div class="flex flex-col items-center gap-1.5 text-xs">
                        <i data-lucide="upload-cloud" class="w-5 h-5 text-cyber-accent"></i>
                        <span class="font-semibold text-stone-700 dark:text-cyber-text">Drop Threat Reports / PDFs</span>
                        <span class="text-[9px] text-stone-400 dark:text-cyber-muted font-mono">Multiple Files Supported</span>
                    </div>
                </div>
            </div>

            <!-- SECTION 2: Dynamic Document Catalog (Scrolling Enabled) -->
            <div class="flex-1 p-3 space-y-2 overflow-y-auto" id="paper-list-container">
                <!-- Empty library state template -->
                <div id="library-empty" class="hidden text-center py-12 px-2 border border-stone-100 dark:border-cyber-border/40 rounded-lg bg-stone-50 dark:bg-cyber-subcard/10">
                    <i data-lucide="folder" class="w-6 h-6 text-stone-300 dark:text-cyber-border mx-auto mb-2"></i>
                    <p class="text-xs text-stone-500 dark:text-cyber-muted">No documents imported.</p>
                </div>
                <!-- Generated cards injected here via runtime JS engine -->
            </div>

            <!-- SECTION 3: LLM Engine Authentication Anchor -->
            <div class="p-4 border-t border-stone-200 dark:border-cyber-border bg-white dark:bg-cyber-card space-y-3 mt-auto">
                <div class="flex items-center justify-between">
                    <label class="block text-xs font-bold font-mono uppercase tracking-wider text-stone-400 dark:text-cyber-muted">
                        Gemini Setup
                    </label>
                    <a href="https://aistudio.google.com/" target="_blank" class="text-[10px] text-cyber-accent hover:underline flex items-center gap-0.5 font-mono">
                        Get Token <i data-lucide="external-link" class="w-2.5 h-2.5"></i>
                    </a>
                </div>

                <!-- API Key fields and dropdown controls -->
                <div class="space-y-2 text-xs">
                    <div class="relative">
                        <input type="password" id="api-key-input" placeholder="AIzaSy..." class="w-full bg-stone-100 dark:bg-cyber-subcard border border-stone-200 dark:border-cyber-border rounded px-2.5 py-1.5 font-mono text-xs focus:outline-none focus:ring-1 focus:ring-cyber-accent dark:text-white" />
                        <button id="toggle-key-visibility" class="absolute right-2.5 top-2 text-stone-400 hover:text-stone-600 dark:hover:text-white" title="Toggle Key Masking">
                            <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>

                    <div class="flex gap-2">
                        <!-- Model selector options -->
                        <select id="model-select" class="flex-1 bg-stone-100 dark:bg-cyber-subcard border border-stone-200 dark:border-cyber-border rounded px-2 py-1.5 font-mono text-[11px] focus:outline-none focus:ring-1 focus:ring-cyber-accent cursor-pointer dark:text-white">
                            <option value="gemini-2.5-flash">Gemini 2.5 Flash</option>
                            <option value="gemini-2.5-pro">Gemini 2.5 Pro</option>
                            <option value="gemini-1.5-flash">Gemini 1.5 Flash</option>
                            <option value="gemini-1.5-pro">Gemini 1.5 Pro</option>
                        </select>
                        
                        <!-- Test Validation trigger -->
                        <button id="btn-test-key" class="px-3 bg-cyber-active hover:bg-rose-800 text-white font-mono text-xs rounded font-semibold flex items-center gap-1 transition-all" title="Test Key Authentication">
                            <i data-lucide="power" class="w-3 h-3" id="test-key-spinner"></i> Test
                        </button>
                    </div>
                </div>

                <div class="flex items-center justify-between text-[10px] text-stone-400 dark:text-cyber-muted font-mono pt-1">
                    <span>Engine: <span id="api-status-label" class="font-bold">Standby</span></span>
                    <label class="flex items-center gap-1.5 cursor-pointer">
                        <input type="checkbox" id="save-key-checkbox" class="rounded border-stone-300 text-cyber-accent focus:ring-cyber-accent h-3 w-3 bg-stone-100 dark:bg-cyber-subcard" />
                        <span>Cache Token</span>
                    </label>
                </div>
            </div>
        </aside>

        <!-- MAIN DUAL SPLIT WORKSPACE: 55% Reader Split | 45% Analyst Column -->
        <main class="flex-1 flex flex-col lg:flex-row overflow-hidden relative w-full h-full">
            
            <!-- PORT A: 55% Width Viewport - Technical Document Theater Area -->
            <section class="w-full lg:w-[55%] h-1/2 lg:h-full flex flex-col bg-stone-100 dark:bg-cyber-slate relative border-b lg:border-b-0 lg:border-r border-stone-200 dark:border-cyber-border overflow-hidden">
                
                <!-- Theater toolbar header -->
                <div class="bg-white dark:bg-cyber-card border-b border-stone-200 dark:border-cyber-border px-4 py-3 flex items-center justify-between z-10">
                    <div class="flex items-center space-x-2 truncate">
                        <div class="p-1 bg-cyber-accent/10 text-cyber-accent rounded">
                            <i data-lucide="file-text" class="w-4 h-4"></i>
                        </div>
                        <div class="truncate">
                            <span class="font-bold text-xs block truncate dark:text-cyber-text" id="viewer-paper-title">Idle Target</span>
                            <span class="text-[10px] text-stone-400 dark:text-cyber-muted font-mono block" id="viewer-paper-meta">Select a cyber research file from the catalog deck.</span>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2">
                        <span id="viewer-badge-type" class="hidden px-2.5 py-0.5 rounded-full font-mono text-[9px] bg-cyber-accent/15 text-cyber-accent border border-cyber-accent/20 uppercase tracking-wider font-semibold">Triage Mode</span>
                    </div>
                </div>

                <!-- Active reader viewer frame -->
                <div class="flex-1 relative flex flex-col justify-center items-center overflow-hidden h-full">
                    
                    <!-- Secure static fallback mode info -->
                    <div id="viewer-empty" class="text-center p-8 space-y-4 max-w-sm z-10">
                        <div class="w-14 h-14 rounded-full bg-stone-200/60 dark:bg-cyber-subcard/60 flex items-center justify-center mx-auto text-stone-400 dark:text-cyber-muted">
                            <i data-lucide="bookmark" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-bold tracking-wider font-mono uppercase text-stone-500 dark:text-cyber-muted">No Selected Workspace Target</h3>
                            <p class="text-[11px] text-stone-400 dark:text-cyber-muted mt-2 leading-relaxed">Select a research paper package from the Library Sidebar to render original binary content. The core model executes on the sandbox payload text context.</p>
                        </div>
                    </div>

                    <!-- Browser security fallback warning card -->
                    <div id="viewer-fallback-warning" class="hidden absolute top-4 left-4 right-4 bg-cyber-accent/10 text-cyber-accent border border-cyber-accent/20 p-3 rounded-lg text-xs z-10 flex items-start gap-2.5">
                        <i data-lucide="shield-alert" class="w-4 h-4 flex-shrink-0 mt-0.5"></i>
                        <div>
                            <p class="font-bold text-cyber-text">Virtual Sandbox Mode Active (Local Memory Execution)</p>
                            <p class="mt-0.5 text-[11px] text-stone-500 dark:text-cyber-muted">Your browser is utilizing Cairn's internal cyber indexing matrix. Visual rendering has been localized for secure assessment.</p>
                        </div>
                    </div>

                    <!-- Browser native embedded PDF controller -->
                    <iframe id="pdf-viewer-frame" class="w-full h-full border-0 hidden" src=""></iframe>
                </div>

                <!-- Footer diagnostics tracking bar -->
                <div class="bg-white dark:bg-cyber-card border-t border-stone-200 dark:border-cyber-border px-4 py-2 flex items-center justify-between text-[10px] font-mono text-stone-400 dark:text-cyber-muted">
                    <span id="diagnostic-engine">Parser Protocol: Hybrid Virtual Extract V3</span>
                    <span id="diagnostic-stat">Tokens Evaluated: 0</span>
                </div>
            </section>

            <!-- PORT B: 45% Width Viewport - Custom AI Workspace and Dialogs (Strict Scroll container) -->
            <section class="w-full lg:w-[45%] h-1/2 lg:h-full flex flex-col bg-white dark:bg-cyber-card overflow-hidden">
                
                <!-- Command suite panel header -->
                <div class="border-b border-stone-200 dark:border-cyber-border px-4 py-3 bg-stone-50/50 dark:bg-cyber-slate/50 flex items-center justify-between">
                    <div class="flex items-center space-x-2">
                        <span class="p-1.5 bg-cyber-accent/10 rounded text-cyber-accent">
                            <i data-lucide="shield-check" class="w-4 h-4"></i>
                        </span>
                        <h2 class="text-xs font-bold font-mono uppercase tracking-wider text-stone-600 dark:text-cyber-muted">Analyst Suite</h2>
                    </div>
                    <button id="btn-clear-workspace" class="text-[10px] font-mono px-2 py-1 rounded bg-stone-200 hover:bg-stone-300 dark:bg-cyber-subcard dark:hover:bg-cyber-border text-stone-600 dark:text-cyber-muted flex items-center gap-1 transition-all">
                        <i data-lucide="trash" class="w-3 h-3"></i> Clear
                    </button>
                </div>

                <!-- COMPACT ACCORDION DRAWER MODULES -->
                <div class="border-b border-stone-200 dark:border-cyber-border flex-shrink-0">
                    <button id="drawer-toggle" class="w-full px-4 py-2.5 bg-stone-50 hover:bg-stone-100 dark:bg-cyber-subcard dark:hover:bg-cyber-border flex items-center justify-between font-mono text-[10px] font-bold tracking-wider uppercase transition-colors text-stone-600 dark:text-cyber-muted">
                        <span class="flex items-center gap-1.5 text-cyber-accent">
                            <i data-lucide="cpu" class="w-3.5 h-3.5 animate-pulse"></i> Diagnostic &amp; Discovery Modules
                        </span>
                        <span id="drawer-arrow-icon" class="transition-transform duration-200">
                            <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
                        </span>
                    </button>
                    
                    <!-- Grid of analytical quick utilities -->
                    <div id="drawer-content" class="bg-stone-50/30 dark:bg-cyber-subcard/20 max-h-0 overflow-hidden transition-all duration-300 ease-out">
                        <div class="p-3 grid grid-cols-2 gap-2 text-[11px]">
                            
                            <button class="analysis-btn p-2 rounded bg-white hover:bg-stone-50 dark:bg-cyber-slate dark:hover:bg-cyber-subcard border border-stone-200 dark:border-cyber-border hover:border-cyber-accent dark:hover:border-cyber-active flex items-center gap-2 transition-all text-left" data-action="summary">
                                <i data-lucide="file-search" class="w-4 h-4 text-rose-400"></i>
                                <div>
                                    <span class="font-bold block text-stone-800 dark:text-cyber-text">Cyber Summary</span>
                                    <span class="text-[9px] text-stone-400 dark:text-cyber-muted">Scope &amp; Discoveries</span>
                                </div>
                            </button>

                            <button class="analysis-btn p-2 rounded bg-white hover:bg-stone-50 dark:bg-cyber-slate dark:hover:bg-cyber-subcard border border-stone-200 dark:border-cyber-border hover:border-cyber-accent dark:hover:border-cyber-active flex items-center gap-2 transition-all text-left" data-action="classification">
                                <i data-lucide="shield" class="w-4 h-4 text-rose-300"></i>
                                <div>
                                    <span class="font-bold block text-stone-800 dark:text-cyber-text">Classifier</span>
                                    <span class="text-[9px] text-stone-400 dark:text-cyber-muted">Taxonomy Mapping</span>
                                </div>
                            </button>

                            <button class="analysis-btn p-2 rounded bg-white hover:bg-stone-50 dark:bg-cyber-slate dark:hover:bg-cyber-subcard border border-stone-200 dark:border-cyber-border hover:border-cyber-accent dark:hover:border-cyber-active flex items-center gap-2 transition-all text-left" data-action="threat_model">
                                <i data-lucide="network" class="w-4 h-4 text-rose-400"></i>
                                <div>
                                    <span class="font-bold block text-stone-800 dark:text-cyber-text">Threat Modeler</span>
                                    <span class="text-[9px] text-stone-400 dark:text-cyber-muted">Attacker Profiling</span>
                                </div>
                            </button>

                            <button class="analysis-btn p-2 rounded bg-white hover:bg-stone-50 dark:bg-cyber-slate dark:hover:bg-cyber-subcard border border-stone-200 dark:border-cyber-border hover:border-cyber-accent dark:hover:border-cyber-active flex items-center gap-2 transition-all text-left" data-action="cve_vulnerabilities">
                                <i data-lucide="skull" class="w-4 h-4 text-cyber-accent"></i>
                                <div>
                                    <span class="font-bold block text-stone-800 dark:text-cyber-text">CVE Engine</span>
                                    <span class="text-[9px] text-stone-400 dark:text-cyber-muted">Extract Flaws</span>
                                </div>
                            </button>

                            <button class="analysis-btn p-2 rounded bg-white hover:bg-stone-50 dark:bg-cyber-slate dark:hover:bg-cyber-subcard border border-stone-200 dark:border-cyber-border hover:border-cyber-accent dark:hover:border-cyber-active flex items-center gap-2 transition-all text-left" data-action="attack_chain">
                                <i data-lucide="git-commit" class="w-4 h-4 text-cyber-amber"></i>
                                <div>
                                    <span class="font-bold block text-stone-800 dark:text-cyber-text">Attack Chain</span>
                                    <span class="text-[9px] text-stone-400 dark:text-cyber-muted">MITRE Stages</span>
                                </div>
                            </button>

                            <button class="analysis-btn p-2 rounded bg-white hover:bg-stone-50 dark:bg-cyber-slate dark:hover:bg-cyber-subcard border border-stone-200 dark:border-cyber-border hover:border-cyber-accent dark:hover:border-cyber-active flex items-center gap-2 transition-all text-left" data-action="red_blue">
                                <i data-lucide="swords" class="w-4 h-4 text-rose-500"></i>
                                <div>
                                    <span class="font-bold block text-stone-800 dark:text-cyber-text">Red vs. Blue</span>
                                    <span class="text-[9px] text-stone-400 dark:text-cyber-muted">Tactical Matrix</span>
                                </div>
                            </button>

                            <button class="analysis-btn p-2 rounded bg-white hover:bg-stone-50 dark:bg-cyber-slate dark:hover:bg-cyber-subcard border border-stone-200 dark:border-cyber-border hover:border-cyber-accent dark:hover:border-cyber-active flex items-center gap-2 transition-all text-left" data-action="evidence">
                                <i data-lucide="check-circle-2" class="w-4 h-4 text-rose-400"></i>
                                <div>
                                    <span class="font-bold block text-stone-800 dark:text-cyber-text">Evidence Index</span>
                                    <span class="text-[9px] text-stone-400 dark:text-cyber-muted">Source Citations</span>
                                </div>
                            </button>

                            <button class="analysis-btn p-2 rounded bg-white hover:bg-stone-50 dark:bg-cyber-slate dark:hover:bg-cyber-subcard border border-stone-200 dark:border-cyber-border hover:border-cyber-accent dark:hover:border-cyber-active flex items-center gap-2 transition-all text-left" data-action="glossary">
                                <i data-lucide="book" class="w-4 h-4 text-rose-300"></i>
                                <div>
                                    <span class="font-bold block text-stone-800 dark:text-cyber-text">Glossary</span>
                                    <span class="text-[9px] text-stone-400 dark:text-cyber-muted">Term Dictionary</span>
                                </div>
                            </button>

                            <!-- DefensiveSOC plays button -->
                            <button class="analysis-btn col-span-2 p-2 rounded bg-white hover:bg-stone-50 dark:bg-cyber-slate dark:hover:bg-cyber-subcard border border-stone-200 dark:border-cyber-border hover:border-cyber-accent dark:hover:border-cyber-active flex items-center justify-center gap-2.5 transition-all text-center" data-action="defensive_actions">
                                <i data-lucide="shield-check" class="w-4 h-4 text-cyber-accent animate-pulse"></i>
                                <span class="font-bold text-stone-800 dark:text-cyber-text">Extract Actionable SOC Hardening Plays</span>
                            </button>

                            <!-- NEW OPTION: Interactive Chatbot query activator -->
                            <button class="analysis-btn col-span-2 p-2 rounded bg-white hover:bg-stone-50 dark:bg-cyber-slate dark:hover:bg-cyber-subcard border border-stone-200 dark:border-cyber-border hover:border-cyber-accent dark:hover:border-cyber-active flex items-center justify-center gap-2.5 transition-all text-center" data-action="ask_chatbot">
                                <i data-lucide="message-square" class="w-4 h-4 text-cyber-accent animate-pulse"></i>
                                <span class="font-bold text-stone-800 dark:text-cyber-text">Ask Chatbot (Interactive Consultation)</span>
                            </button>
                        </div>

                        <!-- Direct AI Consultation Portal -->
                        <div class="mt-2 pt-3 border-t border-stone-200 dark:border-cyber-border/60 px-1 pb-1 flex flex-col space-y-2">
                            <label class="block text-[10px] font-bold font-mono uppercase tracking-wider text-stone-400 dark:text-cyber-muted flex items-center gap-1.5">
                                <i data-lucide="brain-circuit" class="w-3.5 h-3.5 text-cyber-accent animate-pulse"></i> Direct AI Consultation (No Paper Required)
                            </label>
                            <div class="flex gap-2">
                                <input type="text" id="direct-query-input" placeholder="Consult Gemini directly on any cybersecurity concept..." class="flex-1 bg-white dark:bg-cyber-slate border border-stone-300 dark:border-cyber-border rounded px-2.5 py-1.5 text-[11px] focus:outline-none focus:ring-1 focus:ring-cyber-accent placeholder-stone-400 dark:placeholder-cyber-muted text-stone-900 dark:text-white" />
                                <button id="btn-direct-query" class="px-3 bg-cyber-active hover:bg-rose-800 text-white font-mono text-[11px] rounded font-semibold flex items-center gap-1 transition-all" title="Ask Gemini directly">
                                    <i data-lucide="sparkles" class="w-3.5 h-3.5"></i> Ask
                                </button>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- CORE SCROLLABLE ANSWER/INTELLIGENCE FEED PANEL -->
                <div class="flex-1 overflow-y-auto p-4 relative h-full min-h-0" id="analysis-output-container">
                    
                    <!-- HUD loader popup wrapper -->
                    <div id="workspace-loading" class="hidden absolute inset-0 bg-white/95 dark:bg-cyber-card/95 flex flex-col items-center justify-center space-y-4 z-20">
                        <div class="relative w-10 h-10 flex items-center justify-center">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyber-accent opacity-20"></span>
