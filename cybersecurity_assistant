        // SAFE MARKDOWN COMPILER
        function parseSimpleMarkdown(md) {
            let html = md;
            
            html = html.replace(/<(?!\/?[a-zA-Z])/g, "&lt;");

            html = html.replace(/^### (.*$)/gim, '<h4 class="font-bold font-mono text-[11px] text-cyber-accent mt-4 border-b border-stone-200 dark:border-cyber-border pb-1">$1</h4>');
            html = html.replace(/^## (.*$)/gim, '<h3 class="font-bold font-mono text-xs text-stone-800 dark:text-stone-100 mt-5">$1</h3>');
            html = html.replace(/^# (.*$)/gim, '<h2 class="font-extrabold font-mono text-sm text-stone-950 dark:text-white mt-6">$1</h2>');

            html = html.replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-stone-950 dark:text-white">$1</strong>');
            html = html.replace(/\*(.*?)\*/g, '<em class="italic">$1</em>');

            html = html.replace(/^\> (.*$)/gim, '<blockquote class="border-l-4 border-stone-300 dark:border-cyber-border pl-3 italic text-stone-500">$1</blockquote>');

            // Table rendering parser logic
            const lines = html.split('\n');
            let insideTable = false;
            let tableHtml = '<div class="overflow-x-auto my-3"><table class="min-w-full text-[10px] font-mono border border-stone-200 dark:border-cyber-border rounded"><thead>';
            
            for (let i = 0; i < lines.length; i++) {
                if (lines[i].trim().startsWith('|')) {
                    const cells = lines[i].split('|').map(c => c.trim()).filter((c, idx, arr) => idx > 0 && idx < arr.length - 1);
                    
                    if (!insideTable) {
                        insideTable = true;
                        tableHtml += '<tr class="bg-stone-100 dark:bg-cyber-slate border-b border-stone-200 dark:border-cyber-border">' + cells.map(c => `<th class="px-3 py-2 text-left font-bold border-r border-stone-200 dark:border-cyber-border text-stone-700 dark:text-stone-300">${c}</th>`).join('') + '</tr></thead><tbody>';
                    } else if (lines[i].includes('---')) {
                        continue;
                    } else {
                        tableHtml += '<tr class="border-b border-stone-100 dark:border-cyber-border/40">' + cells.map(c => `<td class="px-3 py-1.5 border-r border-stone-100 dark:border-cyber-border/40 text-stone-600 dark:text-stone-400">${c}</td>`).join('') + '</tr>';
                    }
                    lines[i] = "";
                } else if (insideTable) {
                    insideTable = false;
                    tableHtml += '</tbody></table></div>';
                    lines[i] = tableHtml + '\n' + lines[i];
                }
            }
            html = lines.join('\n');

            html = html.replace(/`(.*?)`/g, '<code class="bg-stone-100 dark:bg-cyber-slate px-1.5 py-0.5 rounded font-mono text-[10px] text-cyber-accent">$1</code>');

            html = html.replace(/^\s*-\s+(.*$)/gim, '<li class="list-disc ml-5 mt-1">$1</li>');
            html = html.replace(/^\s*\*\s+(.*$)/gim, '<li class="list-disc ml-5 mt-1">$1</li>');
            html = html.replace(/^\s*(\d+)\.\s+(.*$)/gim, '<li class="list-decimal ml-5 mt-1">$2</li>');

            html = html.replace(/\n\s*\n/g, '<p class="my-2"></p>');

            return html;
        }

