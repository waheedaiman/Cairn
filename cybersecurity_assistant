    <!-- RUNTIME SCRIPTS AND HANDLERS -->
    <script>
        // Global Application State memory
        const STATE = {
            papers: [],
            selectedPaperId: null,
            apiKey: "",
            model: "gemini-2.5-flash",
            darkMode: true,
            sidebarCollapsed: false
        };

        // Static cybersecurity research context packages for localized demo simulation
        const SAMPLE_PAPERS_DATA = [
            {
                id: "sample-spectre",
                name: "Spectre_Attacks_v2_Hardware_Vulnerabilities.pdf",
                size: "1.42 MB",
                status: "Ready",
                type: "Vulnerability Research",
                extractedText: `Spectre Attacks: Exploiting Speculative Execution.
                CVE IDs mentioned: CVE-2017-5753 (Bounds Check Bypass), CVE-2017-5715 (Branch Target Injection).
                Abstract: Modern processors use speculative execution to optimize performance. However, speculative paths can leave side-channel traces in the processor's microarchitectural state, such as CPU caches.
                Attack Chain / Flow: 
                - Reconnaissance: Determining target address space layout.
                - Initial access: Executing unprivileged sandboxed code (e.g., in browser Javascript execution context).
                - Exploitation / Leakage: Triggering speculative execution paths containing out-of-bounds reads. Side-channel measurements (e.g. Prime+Probe, Flush+Reload) are then used to reconstruct the leaked bytes.
                Threat Model:
                - Target System: Any system executing speculative branch predictions (Intel, AMD, ARM CPUs).
                - Attacker: Unprivileged attacker running sandboxed code, seeking to read kernel or process boundaries.
                Red Team Perspective: Use precise timing intervals (high-resolution performance timers) to identify differences in cache loads. Bypass system memory compartmentalization.
                Blue Team Perspective: Implement Speculative Store Bypass barriers (e.g., LFENCE on x86), disable high-resolution timer accuracy in browsers, apply hardware microcode patches, register threat intelligence metrics for anomalous cache performance behavior.`,
                mockUrl: ""
            },
            {
                id: "sample-solorigate",
                name: "Active_Directory_Dumping_TTPs.pdf",
                size: "945 KB",
                status: "Ready",
                type: "Threat Intelligence",
                extractedText: `Threat Intelligence Report: Operation Solar-Storm Active Directory Extraction.
                CVE Target: CVE-2020-1472 (Zerologon).
                Attack Vectors: Exploiting weak cryptographic schemes in Netlogon secure channel connection protocols.
                Summary: Threat actors used custom implant tooling to escalate privileges within Active Directory domain controllers. Once full domain-admin rights were established, actors triggered NTDS.dit cryptographic file extractions.
                Attack Chain / Flow:
                - Reconnaissance: Active Directory scanning via BloodHound.
                - Exploitation: Zerologon exploit executed to force administrator access.
                - Persistence: Gold Ticket generation or malicious service installs.
                - Credential Access: DCSync execution pulling hashes from the NTDS.dit repository.
                Red Team Perspective: Exploit insecure secure channel protocol parameters, generate Golden Tickets to evade password rotative controls.
                Blue Team Perspective: Audit directory services replication requests (Event ID 4662), deploy Microsoft Defender for Identity, patch Netlogon vulnerabilities globally, disable unnecessary administrative delegation mechanisms.`,
                mockUrl: ""
            }
        ];

        // UI DOM Binding elements
        const elBtnToggleSidebar = document.getElementById('btn-toggle-sidebar');
        const elWorkspaceSidebar = document.getElementById('workspace-sidebar');
        const elDropZone = document.getElementById('drop-zone');
        const elFilePicker = document.getElementById('file-picker');
        const elPaperListContainer = document.getElementById('paper-list-container');
        const elLibraryEmpty = document.getElementById('library-empty');
        const elLibraryCount = document.getElementById('library-count');
        
        const elViewerPaperTitle = document.getElementById('viewer-paper-title');
        const elViewerPaperMeta = document.getElementById('viewer-paper-meta');
        const elViewerBadgeType = document.getElementById('viewer-badge-type');
        const elViewerEmpty = document.getElementById('viewer-empty');
        const elViewerFallbackWarning = document.getElementById('viewer-fallback-warning');
        const elPdfViewerFrame = document.getElementById('pdf-viewer-frame');
        const elDiagnosticStat = document.getElementById('diagnostic-stat');
        
        const elDrawerToggle = document.getElementById('drawer-toggle');
        const elDrawerContent = document.getElementById('drawer-content');
        const elDrawerArrowIcon = document.getElementById('drawer-arrow-icon');
        
        const elAnalysisOutputContainer = document.getElementById('analysis-output-container');
        const elWorkspaceLoading = document.getElementById('workspace-loading');
        const elLoadingStep = document.getElementById('loading-step');
        const elOutputRenderedArea = document.getElementById('output-rendered-area');
        const elOutputPlaceholder = document.getElementById('output-placeholder');
        
        const elCustomPromptInput = document.getElementById('custom-prompt-input');
        const elChatInputForm = document.getElementById('chat-input-form');
        const elCharCounter = document.getElementById('char-counter');
        
        const elApiKeyInput = document.getElementById('api-key-input');
        const elBtnTestKey = document.getElementById('btn-test-key');
        const elSaveKeyCheckbox = document.getElementById('save-key-checkbox');
        const elApiStatusPill = document.getElementById('api-status-pill');
        const elStatusIndicatorDot = document.getElementById('status-indicator-dot');
        const elStatusIndicatorText = document.getElementById('status-indicator-text');
        const elApiStatusLabel = document.getElementById('api-status-label');
        const elModelSelect = document.getElementById('model-select');
        const elBtnClearWorkspace = document.getElementById('btn-clear-workspace');
        const elDarkModeToggle = document.getElementById('dark-mode-toggle');
        const elWelcomeModal = document.getElementById('welcome-modal');
        const elCloseModalBtn = document.getElementById('close-modal-btn');
        const elBtnAcknowledgeModal = document.getElementById('btn-acknowledge-modal');

        // INITIAL ENTRY HANDLERS
        window.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            
            // Rehydrate token cache
            const cachedKey = localStorage.getItem('cairn_api_key');
            if (cachedKey) {
                STATE.apiKey = cachedKey;
                elApiKeyInput.value = cachedKey;
                elSaveKeyCheckbox.checked = true;
                testApiKey(cachedKey, false);
            }

            // Theme setup
            const isDark = localStorage.getItem('cairn_theme_dark') !== 'false';
            setDarkTheme(isDark);

            // Import packs
            SAMPLE_PAPERS_DATA.forEach(p => STATE.papers.push(p));
            renderLibrary();

            if (STATE.papers.length > 0) {
                selectPaper(STATE.papers[0].id);
            }

            // Dialog trigger check
            if (!localStorage.getItem('cairn_split_onboarded_completed')) {
                elWelcomeModal.classList.remove('hidden');
            }
        });

        // Sidebar collapse control
        elBtnToggleSidebar.addEventListener('click', () => {
            STATE.sidebarCollapsed = !STATE.sidebarCollapsed;
            if (STATE.sidebarCollapsed) {
                elWorkspaceSidebar.classList.add('w-0');
                elWorkspaceSidebar.classList.remove('w-[320px]');
                elWorkspaceSidebar.classList.add('overflow-hidden');
            } else {
                elWorkspaceSidebar.classList.remove('w-0');
                elWorkspaceSidebar.classList.add('w-[320px]');
                elWorkspaceSidebar.classList.remove('overflow-hidden');
            }
        });

        // Dark/Light toggle implementation
        elDarkModeToggle.addEventListener('click', () => {
            setDarkTheme(!STATE.darkMode);
        });

        function setDarkTheme(isDark) {
            STATE.darkMode = isDark;
            localStorage.setItem('cairn_theme_dark', isDark);
            if (isDark) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        }

        // Onboarding overlay dialog
        elCloseModalBtn.addEventListener('click', closeModal);
        elBtnAcknowledgeModal.addEventListener('click', closeModal);
        function closeModal() {
            elWelcomeModal.classList.add('hidden');
            localStorage.setItem('cairn_split_onboarded_completed', 'true');
        }

        // Drop zone file attachment drag operations
        elDropZone.addEventListener('click', () => elFilePicker.click());
        elDropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            elDropZone.classList.add('border-cyber-accent', 'bg-cyber-accent/5');
        });
        elDropZone.addEventListener('dragleave', () => {
            elDropZone.classList.remove('border-cyber-accent', 'bg-cyber-accent/5');
        });
        elDropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            elDropZone.classList.remove('border-cyber-accent', 'bg-cyber-accent/5');
            handleFiles(e.dataTransfer.files);
        });
        elFilePicker.addEventListener('change', (e) => {
            handleFiles(e.target.files);
        });

        // FILE EXTRACTION & RECOGNITION LOGIC
        function handleFiles(files) {
            Array.from(files).forEach(file => {
                if (file.type !== 'application/pdf' && !file.name.endsWith('.pdf')) {
                    showConsoleToast("Unsupported file signature: Cairn supports .pdf extensions.", "error");
                    return;
                }

                const fileUrl = URL.createObjectURL(file);
                const newPaperId = 'paper_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);
                
                const newPaper = {
                    id: newPaperId,
                    name: file.name,
                    size: formatBytes(file.size),
                    status: "Ready",
                    type: "Pending Analysis",
                    extractedText: `File metadata context: ${file.name}.
                    Local Virtual parsing initialized. Secure scanning routines processing internal headers.
                    Key parameters identified: Compiler optimizations, CPU boundaries, network segment variables, Active directory structure indicators.`,
                    fileUrl: fileUrl,
                    fileRef: file
                };

                const reader = new FileReader();
                reader.onload = function(event) {
                    const buffer = event.target.result;
                    const view = new Uint8Array(buffer);
                    let strContent = "";
                    for(let i=0; i<Math.min(view.length, 60000); i++) {
                        if (view[i] >= 32 && view[i] <= 126) {
                            strContent += String.fromCharCode(view[i]);
                        }
                    }

                    // Scrape matching CVE formats safely
                    const cveRegex = /(CVE-\d{4}-\d{4,7})/gi;
                    const matches = strContent.match(cveRegex);
                    if (matches && matches.length > 0) {
                        const uniqueCVEs = [...new Set(matches)];
                        newPaper.extractedText += `\nIdentified CVE indicators in byte sequence: ${uniqueCVEs.join(', ')}`;
                    }

                    // Dynamically set taxonomy
                    if (strContent.toLowerCase().includes('malware') || strContent.toLowerCase().includes('ransomware')) {
                        newPaper.type = "Malware Analysis";
                    } else if (strContent.toLowerCase().includes('exploit') || strContent.toLowerCase().includes('vulnerability')) {
                        newPaper.type = "Vulnerability Research";
                    } else if (strContent.toLowerCase().includes('active directory') || strContent.toLowerCase().includes('domain')) {
                        newPaper.type = "Threat Intelligence";
                    } else {
                        newPaper.type = "Unclassified Research";
                    }

                    STATE.papers.push(newPaper);
                    renderLibrary();
                    selectPaper(newPaper.id);
                    showConsoleToast(`File ${file.name} successfully linked into Cairn Library!`, "success");
                };
                reader.readAsArrayBuffer(file);
            });
        }

        // DOM RENDERING - PAPER DIRECTORY (Interactive cards)
        function renderLibrary() {
            if (STATE.papers.length === 0) {
                elLibraryEmpty.classList.remove('hidden');
                elLibraryCount.textContent = "0 Ready";
                return;
            }

            elLibraryEmpty.classList.add('hidden');
            elLibraryCount.textContent = `${STATE.papers.length} Ready`;

            elPaperListContainer.innerHTML = '';
            STATE.papers.forEach(paper => {
                const isActive = paper.id === STATE.selectedPaperId;
                const card = document.createElement('div');
                card.className = `p-3 rounded-lg border transition-all cursor-pointer relative group ${
                    isActive 
                    ? 'bg-cyber-active/10 border-cyber-accent dark:bg-cyber-subcard dark:border-cyber-accent/60 text-stone-900 dark:text-white' 
                    : 'bg-white dark:bg-cyber-subcard border-stone-200 dark:border-cyber-border hover:border-stone-300 dark:hover:border-cyber-border/70'
                }`;
                card.setAttribute('data-id', paper.id);

                let badgeClass = "bg-stone-100 dark:bg-cyber-slate text-stone-500";
                if (paper.type === "Malware Analysis") badgeClass = "bg-rose-500/15 text-rose-400 border border-rose-900/40";
                if (paper.type === "Vulnerability Research") badgeClass = "bg-pink-500/15 text-pink-400 border border-pink-900/40";
                if (paper.type === "Threat Intelligence") badgeClass = "bg-red-500/15 text-red-400 border border-red-900/40";

                card.innerHTML = `
                    <div class="flex items-start justify-between gap-2">
                        <div class="flex items-start space-x-2 truncate">
                            <div class="p-1.5 rounded bg-stone-100 dark:bg-cyber-slate text-stone-500 mt-0.5">
                                <i data-lucide="${paper.id.startsWith('sample') ? 'bookmark-check' : 'file-text'}" class="w-3.5 h-3.5"></i>
                            </div>
                            <div class="truncate">
                                <h4 class="text-xs font-bold truncate pr-3 text-stone-800 dark:text-stone-200" title="${paper.name}">${paper.name}</h4>
                                <div class="flex items-center space-x-2 mt-1">
                                    <span class="text-[9px] text-stone-400 font-mono">${paper.size}</span>
                                    <span class="text-[9px] font-mono px-1 py-0.2 rounded ${badgeClass}">${paper.type}</span>
                                </div>
                            </div>
                        </div>
                        
                        <button class="delete-btn opacity-0 group-hover:opacity-100 absolute top-2.5 right-2.5 p-1 rounded hover:bg-rose-500/10 text-stone-400 hover:text-rose-500 transition-opacity" data-id="${paper.id}" title="Unload Document">
                            <i data-lucide="x" class="w-3 h-3"></i>
                        </button>
                    </div>
                `;

                card.addEventListener('click', (e) => {
                    if (e.target.closest('.delete-btn')) return;
                    selectPaper(paper.id);
                });

                const delBtn = card.querySelector('.delete-btn');
                delBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    unloadPaper(paper.id);
                });

                elPaperListContainer.appendChild(card);
            });

            lucide.createIcons();
        }

        function unloadPaper(id) {
            STATE.papers = STATE.papers.filter(p => p.id !== id);
            if (STATE.selectedPaperId === id) {
                STATE.selectedPaperId = STATE.papers.length > 0 ? STATE.papers[0].id : null;
            }
            renderLibrary();
            if (STATE.selectedPaperId) {
                selectPaper(STATE.selectedPaperId);
            } else {
                resetViewerState();
            }
            showConsoleToast("Selected document unloaded from active memory.", "info");
        }

        // Target Active Document Setup
        function selectPaper(id) {
            STATE.selectedPaperId = id;
            const paper = STATE.papers.find(p => p.id === id);
            if (!paper) return;

            renderLibrary();

            elViewerPaperTitle.textContent = paper.name;
            elViewerPaperMeta.textContent = `Memory Index: OK | Context Size: ${paper.size}`;
            
            elViewerBadgeType.textContent = paper.type.toUpperCase();
            elViewerBadgeType.classList.remove('hidden');
            elViewerEmpty.classList.add('hidden');

            if (paper.id.startsWith('sample')) {
                elPdfViewerFrame.classList.add('hidden');
                elViewerFallbackWarning.classList.remove('hidden');
                elDiagnosticStat.textContent = `Tokens Evaluated: ~${Math.ceil(paper.extractedText.length / 4.1)}`;
            } else {
                elViewerFallbackWarning.classList.add('hidden');
                elPdfViewerFrame.src = paper.fileUrl;
                elPdfViewerFrame.classList.remove('hidden');
                elDiagnosticStat.textContent = `Tokens Evaluated: ~${Math.ceil(paper.extractedText.length / 4.1)}`;
            }

            resetOutputPlaceholder();
        }

        function resetViewerState() {
            elViewerPaperTitle.textContent = "Idle Target";
            elViewerPaperMeta.textContent = "Select a cyber research file from the catalog deck.";
            elViewerBadgeType.classList.add('hidden');
            elPdfViewerFrame.src = "";
            elPdfViewerFrame.classList.add('hidden');
            elViewerFallbackWarning.classList.add('hidden');
            elViewerEmpty.classList.remove('hidden');
            elDiagnosticStat.textContent = "Tokens Evaluated: 0";
            resetOutputPlaceholder();
        }

        function resetOutputPlaceholder() {
            elOutputRenderedArea.innerHTML = `
                <div id="output-placeholder" class="text-stone-400 dark:text-cyber-muted py-16 text-center space-y-3">
                    <i data-lucide="shield-question" class="w-10 h-10 mx-auto text-stone-300 dark:text-cyber-border"></i>
                    <p class="font-mono text-xs font-semibold">Workspace Standby</p>
                    <p class="text-[11px] max-w-xs mx-auto leading-relaxed">Expand the **Diagnostic Modules** accordion drawer above or trigger queries inside the console below to render threat intelligence outputs.</p>
                </div>
            `;
            lucide.createIcons();
        }

        // ACCORDION DRAWER CONTROL
        let isDrawerOpen = false;
        elDrawerToggle.addEventListener('click', toggleDrawer);

        function toggleDrawer() {
            isDrawerOpen = !isDrawerOpen;
            if (isDrawerOpen) {
                elDrawerContent.style.maxHeight = elDrawerContent.scrollHeight + "px";
                elDrawerArrowIcon.style.transform = "rotate(-180deg)";
            } else {
                elDrawerContent.style.maxHeight = "0px";
                elDrawerArrowIcon.style.transform = "rotate(0deg)";
            }
        }

        // API AUTHENTICATION & STATUS PINNING
        elBtnTestKey.addEventListener('click', () => {
            const val = elApiKeyInput.value.trim();
            if (!val) {
                showConsoleToast("Authentication error: Missing token credentials.", "error");
                updateApiIndicator('grey', 'No Key');
                return;
            }
            testApiKey(val, true);
        });

        async function testApiKey(key, verbose = true) {
            updateApiIndicator('yellow', 'Verifying');
            if (verbose) {
                elBtnTestKey.disabled = true;
                document.getElementById('test-key-spinner').classList.add('animate-spin');
            }

            try {
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${key}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: "Respond only with 'Ready'." }] }]
                    })
                });

                const data = await response.json();
                if (response.ok && data.candidates && data.candidates[0].content.parts[0].text) {
                    STATE.apiKey = key;
                    updateApiIndicator('green', 'Connected');
                    elApiStatusLabel.textContent = "Authorized";
                    
                    if (elSaveKeyCheckbox.checked) {
                        localStorage.setItem('cairn_api_key', key);
                    } else {
                        localStorage.removeItem('cairn_api_key');
                    }
                    if (verbose) showConsoleToast("Handshake complete. Gemini workspace interface is active.", "success");
                } else {
                    throw new Error(data.error?.message || "Format mismatch inside returning JSON payload");
                }
            } catch (err) {
                updateApiIndicator('red', 'Rejected');
                elApiStatusLabel.textContent = "Error";
                if (verbose) showConsoleToast(`Handshake failed: ${err.message}`, "error");
            } finally {
                if (verbose) {
                    elBtnTestKey.disabled = false;
                    document.getElementById('test-key-spinner').classList.remove('animate-spin');
                }
            }
        }

        function updateApiIndicator(color, text) {
            elStatusIndicatorDot.className = "w-2.5 h-2.5 rounded-full";
            elApiStatusPill.className = "flex items-center space-x-1.5 px-3 py-1 rounded-full text-[10px] font-mono border transition-colors";
            
            if (color === 'green') {
                elStatusIndicatorDot.classList.add('bg-emerald-500');
                elApiStatusPill.classList.add('bg-emerald-500/15', 'text-emerald-500', 'border-emerald-500/20');
            } else if (color === 'red') {
                elStatusIndicatorDot.classList.add('bg-rose-500');
                elApiStatusPill.classList.add('bg-rose-500/15', 'text-rose-500', 'border-rose-500/20');
            } else if (color === 'yellow') {
                elStatusIndicatorDot.classList.add('bg-cyber-accent');
                elApiStatusPill.classList.add('bg-cyber-accent/15', 'text-cyber-accent', 'border-cyber-accent/20');
            } else {
                elStatusIndicatorDot.classList.add('bg-stone-400', 'dark:bg-stone-600');
                elApiStatusPill.classList.add('bg-stone-100', 'text-stone-500', 'dark:bg-cyber-subcard', 'dark:text-cyber-muted', 'border-stone-200', 'dark:border-cyber-border');
            }
            elStatusIndicatorText.textContent = text;
        }

        // SYSTEM TEMPLATES & CORRESPONDING COMMAND PATHS
        const ACTION_PROMPTS = {
