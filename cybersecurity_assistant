        // TOAST INTERFACE LOGGER (Avoid popup alert dependencies)
        function showConsoleToast(message, type = "info") {
            const existingToast = document.getElementById('cairn-toast');
            if (existingToast) existingToast.remove();

            const toast = document.createElement('div');
            toast.id = "cairn-toast";
            
            let colorTheme = "bg-stone-900 border-stone-700 text-stone-100";
            let iconType = "info";
            if (type === "success") {
                colorTheme = "bg-rose-950/90 border-rose-500/30 text-rose-300";
                iconType = "check-circle";
            } else if (type === "error") {
                colorTheme = "bg-rose-950/90 border-rose-500/30 text-rose-300";
                iconType = "alert-triangle";
            }

            toast.className = `fixed bottom-6 right-6 px-4 py-3 border rounded-xl shadow-2xl z-50 text-xs font-mono transition-transform duration-300 translate-y-10 flex items-center space-x-2.5 ${colorTheme}`;
            toast.innerHTML = `<i data-lucide="${iconType}" class="w-4 h-4 flex-shrink-0"></i> <span>${message}</span>`;
            
            document.body.appendChild(toast);
            lucide.createIcons();

            setTimeout(() => {
                toast.classList.remove('translate-y-10');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-5');
                setTimeout(() => toast.remove(), 300);
            }, 4500);
        }

        function formatBytes(bytes, decimals = 2) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const dm = decimals < 0 ? 0 : decimals;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
        }

        // Toggle Key Visibility Masking
        const toggleKeyBtn = document.getElementById('toggle-key-visibility');
